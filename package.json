  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/ssh2": "^1.15.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
