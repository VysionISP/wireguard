{
  "server": {
    "host": "0.0.0.0",
    "port": 8442,
    "publicUrl": "https://provision.example.com"
  },
  "auth": {
    "provisioningToken": "CHANGE-ME-long-random-string-1",
    "adminToken": "CHANGE-ME-long-random-string-2",
    "allowMasterProvisioningToken": true,
    "sessionHours": 12
  },
  "wireguard": {
    "interface": "wg0",
    "serverPublicKey": "SERVER_WG_PUBLIC_KEY_BASE64=",
    "endpointHost": "vpn.example.com",
    "endpointPort": 51820,
    "mgmtCidr": "10.99.0.0/16",
    "serverTunnelIp": "10.99.0.1",
    "persistentKeepalive": 25,
    "applyMode": "wg"
  },
  "router": {
    "wgInterfaceName": "wg-mgmt",
    "username": "wg-mgmt",
    "strictTls": false
  },
  "monitor": {
    "intervalSeconds": 60,
    "offlineAfterSeconds": 180
  },
  "hardening": {
    "disableServices": ["telnet", "ftp"],
    "dns": [],
    "ntpServers": [],
    "identityPrefix": ""
  },
  "backup": {
    "enabled": true,
    "intervalHours": 24,
    "dir": "data/backups",
    "keep": 30
  },
  "alerts": {
    "webhookUrl": "",
    "telegramBotToken": "",
    "telegramChatId": "",
    "notifyOnRegister": true,
    "notifyOnline": true,
    "suppressMinutes": 15
  },
  "deviceMonitor": {
    "enabled": true,
    "intervalSeconds": 120,
    "enableNewByDefault": true,
    "defaultAlertOnLogin": true,
    "defaultAlertOnLinkDown": true
  },
  "storePath": "data/routers.json",
  "tokensPath": "data/tokens.json",
  "usersPath": "data/users.json",
  "auditPath": "data/audit.jsonl",
  "issuesPath": "data/issues.json",
  "eventsPath": "data/events.jsonl"
}
